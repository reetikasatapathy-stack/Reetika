ell_type":"code","source":["\n","import os\n","import re\n","import csv\n","from datetime import datetime\n","\n","DATA_DIR = \"data\"\n","REPORT_DIR = os.path.join(DATA_DIR, \"reports\")\n","HISTORY_FILE = os.path.join(DATA_DIR, \"run_history.csv\")\n","\n","os.makedirs(REPORT_DIR, exist_ok=True)\n","\n","# Three-field record: part code, diameter, shift\n","pattern = re.compile(\n","    r\"^\\s*(P\\d{3})\\s*,\\s*\"\n","    r\"(\\d+(?:\\.\\d+)?)\\s*,\\s*\"\n","    r\"(S\\d)\\s*$\"\n",")\n","\n","# Plant-wide counters\n","plant_counts = {\n","    \"ACCEPT\": 0,\n","    \"REWORK\": 0,\n","    \"SCRAP\": 0\n","}\n","\n","plant_processed = 0\n","plant_rejected = 0\n","\n","# One timestamp for this complete run\n","timestamp = datetime.now().isoformat(timespec=\"seconds\")\n","\n","# Find every input TXT file directly inside data/\n","input_files = sorted(\n","    filename\n","    for filename in os.listdir(DATA_DIR)\n","    if filename.lower().endswith(\".txt\")\n","    and os.path.isfile(os.path.join(DATA_DIR, filename))\n","    and filename != \"plant_summary.txt\"\n","    and not filename.startswith(\"report_\")\n",")\n","\n","history_rows = []\n","\n","# Process each file\n","for filename in input_files:\n","\n","    filepath = os.path.join(DATA_DIR, filename)\n","\n","    counts = {\n","        \"ACCEPT\": 0,\n","        \"REWORK\": 0,\n","        \"SCRAP\": 0\n","    }\n","\n","    rejects = []\n","    processed = 0\n","\n","    # READ\n","    with open(filepath, \"r\") as file:\n","        lines = file.readlines()\n","\n","    # PARSE AND VALIDATE\n","    for line_number, line in enumerate(lines, start=1):\n","\n","        raw = line.strip()\n","        match = pattern.fullmatch(raw)\n","\n","        if not match:\n","            rejects.append((line_number, raw, \"Invalid format\"))\n","            continue\n","\n","        code, diameter_text, shift = match.groups()\n","\n","        try:\n","            diameter = float(diameter_text)\n","        except ValueError:\n","            rejects.append((line_number, raw, \"Invalid diameter\"))\n","            continue\n","\n","        if diameter <= 0:\n","            rejects.append((line_number, raw, \"Non-positive diameter\"))\n","            continue\n","\n","        # CLASSIFY\n","        if 9.8 <= diameter <= 10.2:\n","            label = \"ACCEPT\"\n","        elif 9.5 <= diameter <= 10.5:\n","            label = \"REWORK\"\n","        else:\n","            label = \"SCRAP\"\n","\n","        # AGGREGATE\n","        counts[label] += 1\n","        processed += 1\n","\n","    rejected = len(rejects)\n","\n","    # Update plant totals\n","    for label in plant_counts:\n","        plant_counts[label] += counts[label]\n","\n","    plant_processed += processed\n","    plant_rejected += rejected\n","\n","    # WRITE INDIVIDUAL REPORT\n","    report_name = \"report_\" + filename.replace(\".txt\", \"\") + \".txt\"\n","    report_path = os.path.join(REPORT_DIR, report_name)\n","\n","    with open(report_path, \"w\") as report:\n","\n","        report.write(\"========== FILE SHIFT REPORT ==========\\n\")\n","        report.write(f\"File: {filename}\\n\")\n","        report.write(f\"{'BIN':<15}{'COUNT':>10}\\n\")\n","        report.write(\"-\" * 25 + \"\\n\")\n","\n","        for label, count in counts.items():\n","            report.write(f\"{label:<15}{count:>10}\\n\")\n","\n","        report.write(\"-\" * 25 + \"\\n\")\n","        report.write(f\"Records processed: {processed}\\n\")\n","        report.write(f\"Rejected records: {rejected}\\n\")\n","\n","        report.write(\n","            \"Audit: \" +\n","            str(sum(counts.values()) == processed) + \"\\n\"\n","        )\n","\n","    # Prepare history entry\n","    history_rows.append([\n","        timestamp,\n","        filename,\n","        processed,\n","        rejected\n","    ])\n","\n","    print(\"Processed:\", filename)\n","\n","\n","# WRITE COMBINED PLANT SUMMARY\n","with open(os.path.join(DATA_DIR, \"plant_summary.txt\"), \"w\") as report:\n","\n","    report.write(\"========== PLANT SUMMARY ==========\\n\\n\")\n","\n","    report.write(f\"{'BIN':<15}{'COUNT':>10}\\n\")\n","    report.write(\"-\" * 25 + \"\\n\")\n","\n","    for label, count in plant_counts.items():\n","        report.write(f\"{label:<15}{count:>10}\\n\")\n","\n","    report.write(\"-\" * 25 + \"\\n\")\n","    report.write(f\"Total processed: {plant_processed}\\n\")\n","    report.write(f\"Total rejected: {plant_rejected}\\n\")\n","\n","    report.write(\n","        \"Plant audit: \" +\n","        str(sum(plant_counts.values()) == plant_processed)\n","        + \"\\n\"\n","    )\n","\n","\n","# APPEND RUN HISTORY\n","history_exists = (\n","    os.path.exists(HISTORY_FILE)\n","    and os.path.getsize(HISTORY_FILE) > 0\n",")\n","\n","with open(HISTORY_FILE, \"a\", newline=\"\") as file:\n","\n","    writer = csv.writer(file)\n","\n","    if not history_exists:\n","        writer.writerow([\n","            \"timestamp\",\n","            \"file_name\",\n","            \"records_processed\",\n","            \"rejects\"\n","        ])\n","\n","    writer.writerows(history_rows)\n","\n","\n","# FINAL CONSOLE SUMMARY\n","print(\"\\n========== PLANT RUN COMPLETE ==========\")\n","print(\"Files processed:\", len(input_files))\n","print(\"Total records:\", plant_processed)\n","print(\"Total rejects:\", plant_rejected)\n","print(\"ACCEPT:\", plant_counts[\"ACCEPT\"])\n","print(\"REWORK:\", plant_counts[\"REWORK\"])\n","print(\"SCRAP:\", plant_counts[\"SCRAP\"])\n","print(\"Plant audit:\",\n","      sum(plant_counts.values()) == plant_processed)\n","\n","print(\"\\nReports saved:\", REPORT_DIR)\n","print(\"Plant summary: data/plant_summary.txt\")\n","print(\"History: data/run_history.csv\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xLOYgMW2Li89","executionInfo":{"status":"ok","timestamp":1793957229187,"user_tz":-330,"elapsed":16,"user":{"displayName":"Reetika Satapathy","userId":"1258782821